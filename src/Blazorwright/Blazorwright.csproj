<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Deterministic Playwright tests for Blazor apps. await Page.WaitForBlazorIdleAsync() returns once the app has finished reacting: no .NET calls in flight, no render batches pending and a quiet DOM, on Server, WebAssembly and Auto, with no changes to the app under test.</Description>
    <!-- Ships the doc comments for IntelliSense. Comments describe only what needs explaining, so a member or parameter
         without one doesn't fail the build. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tracker.js" LogicalName="Blazorwright.tracker.js" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazorwright.Tests.Unit" />
  </ItemGroup>

</Project>
