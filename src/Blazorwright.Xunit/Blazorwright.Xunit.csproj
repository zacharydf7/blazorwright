<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>xUnit v3 base class for Blazorwright: each test gets a Playwright page with Blazor tracking installed, pointed at the app, and keeps a trace and video when it fails.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright.Xunit.v3" Version="1.64.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Blazorwright\Blazorwright.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Blazorwright.Tests.Browser" />
  </ItemGroup>

</Project>
