<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/TestApp.Widgets/widgets.css"]" />
    <HeadOutlet />
</head>
<body>
    <Routes />
    <div id="blazor-error-ui" style="display: none">An error has occurred. <a href="" class="reload">Reload</a></div>
    <script>
        window.spikeInterop = {
            measureAfter: ms => new Promise(resolve => setTimeout(() => resolve(240), ms)),
            showModal: dialog => dialog.showModal(),
            close: dialog => dialog.close(),
            showPopover: panel => panel.showPopover(),
            tick: (label, spinner, log, note) => {
                const start = performance.now();
                const elapsed = () => Math.round(performance.now() - start);
                setInterval(() => spinner.style.rotate = `${elapsed() % 360}deg`, 10);
                setInterval(() => label.firstChild.data = `${elapsed()} ms`, 50);
                setInterval(() => log.append(document.createElement('li')), 200);
                setInterval(() => note.textContent = `${elapsed()}`, 500);
            },
        };
    </script>
    <script src="@Assets[ScriptPath]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    // Pages under /serverjs use the older Blazor Server script, which many existing Server apps still load.
    private string ScriptPath => HttpContext.Request.Path.StartsWithSegments("/serverjs")
        ? "_framework/blazor.server.js"
        : "_framework/blazor.web.js";
}
