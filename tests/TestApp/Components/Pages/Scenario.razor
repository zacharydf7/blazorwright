@page "/{Mode}/{Name}"

@switch (Name)
{
    case "delayed":
        <Delayed @rendermode="RenderModeFor(Mode)" />
        <a href="/@Mode/counter">Counter page</a>
        break;
    case "counter":
        <Counter @rendermode="RenderModeFor(Mode)" />
        break;
    case "throws":
        <Throws @rendermode="RenderModeFor(Mode)" />
        break;
    case "dropdown":
        <Dropdown @rendermode="RenderModeFor(Mode)" />
        break;
    case "toggle":
        <Toggle @rendermode="RenderModeFor(Mode)" />
        break;
    case "updates":
        <Updates @rendermode="RenderModeFor(Mode)" />
        break;
    case "rename":
        <Rename @rendermode="RenderModeFor(Mode)" />
        break;
    case "confirm":
        <Confirm @rendermode="RenderModeFor(Mode)" />
        break;
    case "filters":
        <Filters @rendermode="RenderModeFor(Mode)" />
        break;
    case "measure":
        <Measure @rendermode="RenderModeFor(Mode)" />
        break;
    case "stuck":
        <Stuck @rendermode="RenderModeFor(Mode)" />
        break;
}

@code {
    [Parameter] public string Mode { get; set; } = "";
    [Parameter] public string Name { get; set; } = "";

    private static IComponentRenderMode RenderModeFor(string mode) => mode switch
    {
        "server" or "serverjs" => InteractiveServer,
        "wasm" => InteractiveWebAssembly,
        "auto" => InteractiveAuto,
        _ => throw new ArgumentException($"Unknown render mode '{mode}'.", nameof(mode)),
    };
}
